# Cloud Postgres (Supabase). Express uses this as the database only.
# Dashboard → Project Settings → Database → Database password
# Also set these on Vercel → Settings → Environment Variables (Production).
SUPABASE_URL=https://rcexagktpinoalceodyc.supabase.co
SUPABASE_DB_PASSWORD=
# Vercel cannot use db.*.supabase.co (IPv6). Pooler is used automatically on Vercel.
# SUPABASE_REGION=ap-south-1
# SUPABASE_POOLER_HOST=aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Optional override. If SUPABASE_DB_PASSWORD is set, this is ignored.
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.rcexagktpinoalceodyc.supabase.co:5432/postgres

JWT_SECRET=change-this-to-a-long-random-secret
PORT=4000
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_PASSWORD=Elva@1234
SUPER_ADMIN_NAME=ELVA Super Admin

